# MetricCenter 本地开发配置
# 用法：cp .env.local.example .env.local，然后按你的本机 PostgreSQL 账号修改。
# .env.local 已被 .gitignore 忽略，不会入库；本示例文件作为模板保留。

# 控制面元数据库连接串（PostgreSQL 16）。
# 密码含特殊字符时需 URL 编码：@ -> %40，: -> %3A，/ -> %2F，# -> %23 等。
# 数据库需要预先创建好（本地 trust 认证的默认库可用 make db-init 自动创建）。
METRIC_CENTER_DB_DSN=postgres://myuser:mypassword@127.0.0.1:5432/metric_center?sslmode=disable

# 可选：控制面 admin 初始密码（默认 admin123）
METRIC_CENTER_ADMIN_PASSWORD=admin123
