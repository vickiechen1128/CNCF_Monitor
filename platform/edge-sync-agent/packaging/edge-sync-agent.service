# systemd unit — Edge Sync Agent（Module_11 边缘采集客户端）
#
# 父进程模式：edge-sync-agent 是守护进程，负责自身心跳/拉包并作为 supervisor 拉起
# 采集器(vmagent/prometheus) 与 blackbox_exporter 子进程。系统级 Restart=always 兜底。
#
# 安装：
#   1) 解压离线包到 /opt/apps/edge-sync-agent/（程序目录，只读）；二进制在 bin/ 子目录，
#      按架构把对应可执行文件链接/拷贝到上层路径，使 ExecStart 可找到：
#        ln -s /opt/apps/edge-sync-agent/bin/edge-sync-agent-linux-$(uname -m | ...) \
#              /opt/apps/edge-sync-agent/edge-sync-agent
#      （也可直接改 ExecStart 指向 bin/ 下对应 arch 的二进制）
#   2) 编辑服务环境配置 /opt/apps/edge-sync-agent/env/edge-sync-agent.env，
#      填入三项必填（NETWORK_DOMAIN_ID / TOKEN / CENTER_ENDPOINT），其余已给推荐值；
#      ARM64 机器把两个 *_BIN 路径中的 -amd64 改成 -arm64
#   3) 拷贝本 unit 到 /etc/systemd/system/edge-sync-agent.service
#   4) systemctl daemon-reload && systemctl enable --now edge-sync-agent
#
# 查看日志：journalctl -u edge-sync-agent -f

[Unit]
Description=MetricCenter Edge Sync Agent (Module_11)
Documentation=docs/02-product-requirements/Modules/Module_11_Edge_Access_and_Agent_Delivery.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 父进程作为系统服务运行；采集器/拨测器作为其子进程由 Agent 守护
ExecStart=/opt/apps/edge-sync-agent/edge-sync-agent
Restart=always
RestartSec=5s

# 环境变量统一由服务配置文件提供（EnvironmentFile 加载，路径为安装包固定布局）：
#   /opt/apps/edge-sync-agent/env/edge-sync-agent.env
# 该文件已内置全量变量推荐值，部署时只需填三项必填：
#   NETWORK_DOMAIN_ID / TOKEN / CENTER_ENDPOINT（每网域 Token 由中心门户纳管时签发）
# 其中采集器/拨测器二进制路径必须显式指向包内 bin/*-linux-<arch>（不在 PATH），
# 配置缓存/数据目录指向可写盘 /opt/data/edge-sync-agent（程序盘 /opt/apps 只读）。
EnvironmentFile=/opt/apps/edge-sync-agent/env/edge-sync-agent.env

# 优雅停止：等 Agent 取消上下文并停止子进程
TimeoutStopSec=15
KillMode=mixed
KillSignal=SIGTERM

# 安全加固（按需）：
# - 不需要绑定特权端口，禁止提权
NoNewPrivileges=true
PrivateTmp=true
# - 若 blackbox 需 ICMP 拨测（PRD §6.4.2），授予 CAP_NET_RAW：
#   AmbientCapabilities=CAP_NET_RAW
#   CapabilityBoundingSet=CAP_NET_RAW
# - 生产目录只读（配置数据走 EDGE_CONFIG_ROOT/EDGE_WAL_DIR 独立数据盘）

[Install]
WantedBy=multi-user.target
