# Edge Sync Agent 服务环境变量（systemd 通过 EnvironmentFile= 加载本文件）
# 部署位置：/opt/apps/edge-sync-agent/env/edge-sync-agent.env
#
# 填写规则：
#   1) 三项「必填」按中心网域纳管页实际值填写（网域 ID / 接入 Token / 中心地址）；
#   2) 其余项已给出推荐默认值，一般无需改动；
#   3) ARM64（麒麟 V10）部署时，把两个 *_BIN 路径中的 -amd64 改成 -arm64；
#   4) 改 EDGE_COLLECTOR_ADDR 时必须同步改 EDGE_PROM_HEALTH_URL 的端口，
#      否则组件会被反复判为不健康并触发重启。

# ===== 身份与中心地址（必填）=====
NETWORK_DOMAIN_ID=
TOKEN=
CENTER_ENDPOINT=http://<中心地址>:<端口>

# ===== Agent 版本与可写数据目录（可选/推荐）=====
# 程序盘 /opt/apps 只读，配置缓存请放独立可写盘 /opt/data
EDGE_AGENT_VERSION=__VERSION__
EDGE_CONFIG_ROOT=/opt/data/edge-sync-agent/edge-config
EDGE_WAL_DIR=/opt/data/edge-sync-agent/vmagent-cache

# ===== 采集器/拨测器二进制（必须显式给路径：包内二进制带 arch 后缀且不在 PATH）=====
EDGE_COLLECTOR_BIN=/opt/apps/edge-sync-agent/bin/vmagent-linux-amd64
EDGE_BLACKBOX_BIN=/opt/apps/edge-sync-agent/bin/blackbox_exporter-linux-amd64

# ===== 本机监听端口（默认仅绑回环，不占对外端口，无需放通网络策略）=====
EDGE_COLLECTOR_ADDR=127.0.0.1:8429
EDGE_PROM_HEALTH_URL=http://127.0.0.1:8429/health
EDGE_BLACKBOX_ADDR=127.0.0.1:9115
